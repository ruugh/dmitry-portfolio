---
const {
  title = 'Дмитрий Корчагин',
  description = 'Портфолио',
  backHref,
  backLabel = 'Назад в Портфолио',
} = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      /* === LIGHT THEME TOKENS (reserved, not applied) ===
      :root[data-theme="light"] {
        --bg: #ffffff; --bg-rgb: 255,255,255;
        --fg: #0f172a; --muted: #64748b;
        --card: #f8fafc; --link: #185FA5;
        --border: rgba(0,0,0,.08);
        --primary: #185FA5; --primary-fg: #ffffff;
        --accent: #185FA5; --success: #16a34a;
      }
      === END LIGHT THEME TOKENS === */
      :root {
        --bg: #0F1117; --bg-rgb: 15,17,23;
        --fg: #e2e8f0; --muted: #94a3b8;
        --card: #1A1D2E; --link: #93C5FD;
        --border: rgba(255,255,255,.08);
        --primary: #378ADD; --primary-fg: #ffffff;
        --accent: #93C5FD; --success: #4ADE80;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      html { min-height: 100%; }
      body {
        margin:0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial;
        background: var(--bg);
        color: var(--fg);
      }
      :global(a),
      :global(a:visited) {
        color: var(--fg);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: rgba(255,255,255,.55);
      }
      :global(a:hover) { text-decoration-color: rgba(255,255,255,.9); }
      header { position: sticky; top:0; z-index: 100; background: rgba(var(--bg-rgb), .92); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,.08); }
      .wrap { max-width: 760px; margin: 0 auto; padding: 16px 20px; }
      header .wrap { max-width: 1200px; padding-top: 0; padding-bottom: 0; min-height: 75px; display: flex; flex-direction: column; justify-content: center; }
      nav { display:flex; gap:14px; align-items:center; }
      nav a { color: var(--fg); opacity: 1; text-decoration: none !important; }

      /* Header layout */
      .nav-row { position: relative; display:flex; align-items:center; justify-content: center; }

      .nav-links { display:flex; align-items:center; gap:34px; }
      .nav-socials { position: absolute; right: 0; display:flex; align-items:center; gap:16px; }
      .nav-social {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        color: #ffffff;
        text-decoration: none !important;
      }
      .nav-social svg {
        display: block;
        width: 24px;
        height: 24px;
      }
      .nav-social:hover { opacity: .82; }
      .btn, :global(.btn) { display:inline-flex; align-items:center; justify-content:center; height: 44px; padding: 0 20px; border-radius: 999px; font-size: 14px; font-weight: 600; line-height: 1; text-decoration: none !important; border: 1px solid rgba(255,255,255,.18); background: transparent; color: var(--fg); }
      .btn:hover, :global(.btn):hover { border-color: rgba(255,255,255,.4); }
      .btn--primary, :global(.btn--primary) { background: var(--primary); border-color: var(--primary); color: var(--primary-fg); }
      .btn--primary:hover, :global(.btn--primary):hover { opacity: .88; }
      .btn--outline, :global(.btn--outline) { background: transparent !important; border-color: #378ADD !important; color: #378ADD !important; }
      .btn--outline:hover, :global(.btn--outline):hover { opacity: .8; }

      .burger { display:none; align-items:center; justify-content:center; width: 38px; height: 38px; border-radius: 10px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.03); color: #fff; cursor: pointer; }
      .burger:hover { border-color: rgba(255,255,255,.22); }
      .burger svg { width: 20px; height: 20px; display: block; stroke: currentColor; }
      .mobile-menu { display:none; border-top: 1px solid rgba(255,255,255,.08); padding-top: 12px; margin-top: 12px; }
      .mobile-menu a { display:block; padding: 10px 0; text-decoration: none !important; }
      .mobile-menu .mobile-socials { display:flex; gap:14px; padding-top: 12px; }

      @media (max-width: 700px) {
        .nav-row { display:flex; }
        .nav-links, .nav-socials { display:none; }
        .burger { display:inline-flex; margin-left: auto; }
        .mobile-menu[data-open='true'] { display:block; }
      }
      main {
        flex: 1 0 auto;
        padding: 28px 0 0;
      }
      .page-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 28px;
        color: #fff !important;
        font-size: 14px;
        font-weight: 400;
        line-height: 1.4;
        text-decoration: none !important;
      }
      .page-back:hover { opacity: .82; }
      .page-back__arrow {
        flex: none;
        width: 16px;
        height: 16px;
        display: block;
      }
      .grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); gap: 14px; }
      /* Home now renders purely from Notion content (see src/pages/index.astro) */
      .card { background: var(--card); border: 0; border-radius: 0; padding: 14px 16px; display:block; transition: transform .12s ease, border-color .12s ease, background .12s ease; }
      .card:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.14); }
      :global(.card img) { width:100%; height: 220px; object-fit: contain; border-radius: 0; margin-bottom: 10px; display:block; background: rgba(255,255,255,.03); }
      .card .title { display:block; font-weight: 700; }
      .muted { color: var(--muted); }

      /* HOME RESET: keep the page stable, but allow intentional full-bleed on home */
      :global(article) { overflow-x: hidden; }
      :global(body[data-page='home'] article) { overflow-x: visible; }
      :global(body[data-page='home'] main) { overflow-x: visible; }
      :global(body[data-page='home'] .wrap) { overflow-x: visible; }
      :global(body[data-page='home']) { overflow-x: hidden; }
      :global(article h1, article h2, article h3) { margin: 22px 0 10px; }
      :global(body[data-page='home'] #homeContent .home-first-media) { margin-top: 34px; }
      :global(body[data-page='home'] article h2) { margin-top: 22px; }
      :global(body[data-page='home'] article h3) { margin-top: 22px; }
      :global(body[data-page='home'] article p.case-cta) { margin-bottom: 3.5em; }
      :global(article p, article li, article blockquote) { line-height: 1.55; }

      /* Notion-ish defaults */
      :global(article figure) { margin: 18px 0; }
      :global(article img) { max-width: 100%; height: auto; display: block !important; }

      :global(article .notion-image figure) { margin: 0; }
      :global(article .notion-image img) { display: block !important; }

      /* Default images: centered, document-like */
      :global(article figure img) {
        max-width: min(100%, 820px);
        width: auto;
        height: auto;
        max-height: 72vh;
        object-fit: contain;
        border-radius: 0;
        background: rgba(255,255,255,.03);
        border: 0;
        margin: 0 auto;
        cursor: zoom-in;
      }
      :global(body[data-page='home'] article figure img) {
        cursor: pointer;
      }

      /* Home portfolio images: allow 1000px-wide images without widening the text column.
         We do it by letting the figure "bleed" out of the 760px wrap while staying centered. */
      :global(body[data-page='home'] #homeContent > figure),
      :global(body[data-page='home'] #homeContent > .notion-image) {
        /* Let these 4 Notion images break out of the 760px wrap but stay centered in the viewport */
        width: min(1000px, calc(100vw - 40px));
        margin-left: calc(50% - min(500px, calc(50vw - 20px)));
        margin-right: calc(50% - min(500px, calc(50vw - 20px)));
        margin-top: 18px;
        margin-bottom: 18px;
      }

      :global(body[data-page='home'] #homeContent > figure img),
      :global(body[data-page='home'] #homeContent > .notion-image figure img) {
        width: 100% !important;
        max-width: 100% !important;
        max-height: none;
        margin: 0;
      }

      /* Wide images: fill their container only (no bleed).
         IMPORTANT: target the stable marker (figure.wide) so it works even if wrapper divs change. */
      :global(article figure.wide) { margin: 18px 0; padding: 0; }
      :global(article figure.wide img) {
        width: 100% !important;
        max-width: 100% !important;
        height: auto;
        max-height: none;
        margin: 0;
        border: 0 !important;
        background: transparent !important;
        border-radius: 0;
        display: block !important;
      }

      :global(article figcaption) { margin-top: 8px; font-size: 14px; color: var(--muted); }
      :global(article blockquote) { border-left: 3px solid rgba(255,255,255,.15); margin: 16px 0; padding: 6px 12px; color: var(--muted); }
      :global(article hr) { border:0; border-top: 1px solid rgba(255,255,255,.1); margin: 22px 0; }
      :global(article .mermaid) {
        margin: 18px 0;
        overflow-x: auto;
        background: rgba(255,255,255,.02);
        border: 0;
        border-radius: 0;
        padding: 16px;
        cursor: zoom-in;
      }
      :global(article .mermaid svg) {
        cursor: zoom-in;
      }
      :global(.callout) {
        background: rgba(255,255,255,.02);
        border: 1px solid rgba(255,255,255,.10);
        padding: 20px;
        border-radius: 0;
      }
      :global(.callout-children) { margin-top: 12px; }
      /* Notion-like columns: no card frame/padding, just a gap */
      :global(.columns) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 32px;
        border: none;
        border-radius: 0;
        overflow: visible;
        background: transparent;
      }
      :global(.column) {
        min-width: 0;
        padding: 0;
        border: none;
        overflow: hidden;
      }
      :global(.column + .column) {
        border-left: none;
      }
      :global(details.toggle) { border: 0; border-radius: 0; padding: 10px 12px; background: rgba(255,255,255,.03); margin: 16px 0; }
      :global(details.toggle > summary) { cursor: pointer; }
      :global(details.toggle .toggle-children) { margin-top: 10px; padding-left: 14px; border-left: 1px solid rgba(255,255,255,.08); min-width: 0; overflow: hidden; }
      :global(details.toggle .toggle-children > :first-child) { margin-top: 0; }
      :global(details.toggle .toggle-children .table-wrap) { max-width: 100%; overflow-x: auto; margin: 12px 0; }
      :global(details.toggle .toggle-children table.notion-table) { width: 100%; min-width: 0; table-layout: fixed; }
      :global(details.toggle .toggle-children table.notion-table th),
      :global(details.toggle .toggle-children table.notion-table td) { word-break: break-word; }

      :global(.table-wrap) { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 16px 0; }

      /* Debug/High-contrast table styling (we can soften later) */
      article :global(table) {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid rgba(255,255,255,.14);
      }
      article :global(th),
      article :global(td) {
        padding: 10px 12px;
        border: 1px solid rgba(255,255,255,.14);
        font-size: 14px;
      }
      article :global(th) {
        font-weight: 700;
        background: rgba(255,255,255,.04);
      }

      :global(table.notion-table) {
        border-collapse: collapse;
        width: 100%;
        min-width: 640px;
        background: rgba(255,255,255,.02);
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 0;
        overflow: hidden;
      }
      :global(table.notion-table td),
      :global(table.notion-table th) {
        border-top: 1px solid rgba(255,255,255,.14);
        border-right: 1px solid rgba(255,255,255,.14);
        padding: 10px 12px;
        vertical-align: top;
        color: var(--fg);
        font-size: 14px;
      }
      :global(table.notion-table tr:first-child td),
      :global(table.notion-table tr:first-child th) { border-top: none; }
      :global(table.notion-table td:last-child),
      :global(table.notion-table th:last-child) { border-right: none; }
      :global(table.notion-table.has-header tr:first-child th) { background: rgba(255,255,255,.05); }
      footer { border-top: 0; }
      .site-footer { padding-bottom: 0; }
      .footer-cta {
        background: #1c1e25;
        border-radius: 30px 30px 0 0;
        padding: 37px 30px 32px;
        width: min(1200px, calc(100vw - 40px));
        margin: 0 auto;
      }
      .footer-cta__body { display: flex; flex-direction: column; gap: 8px; margin-bottom: 64px; }
      .footer-cta__heading { font-size: 36px; font-weight: 700; line-height: 1.2; color: #fff; margin: 0; }
      .footer-cta__sub { font-size: 20px; font-weight: 400; color: #fff; margin: 0; }
      .footer-cta__links { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; max-width: 1140px; margin-bottom: 40px; }
      .footer-cta__socials { display: flex; align-items: center; gap: 64px; }
      .footer-cta__link { display: inline-flex; align-items: center; gap: 8px; font-size: 20px; font-weight: 400; color: #fff; text-decoration: none !important; transition: opacity .15s; }
      .footer-cta__link:hover { opacity: .75; }
      .footer-cta__copy { font-size: 13px; color: rgba(255,255,255,0.35); margin: 0; }
      @media (max-width: 600px) {
        .footer-cta { padding: 28px 20px 24px; }
        .footer-cta__heading { font-size: 24px; }
        .footer-cta__sub { font-size: 16px; }
        .footer-cta__body { margin-bottom: 40px; }
        .footer-cta__links { flex-direction: column; align-items: flex-start; gap: 20px; }
        .footer-cta__socials { flex-wrap: wrap; gap: 24px; }
        .footer-cta__link { font-size: 16px; }
      }

      /* Lightbox */
      .lightbox {
        position: fixed;
        inset: 0;
        display: none;
        place-items: center;
        background: rgba(0,0,0,.82);
        z-index: 9999;
        padding: 24px;
      }
      .lightbox.open { display: grid; }
      .lightbox__img {
        max-width: min(96vw, 1600px);
        max-height: 92vh;
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: 0;
        box-shadow: 0 20px 80px rgba(0,0,0,.6);
        cursor: zoom-out;
      }
      .lightbox__close {
        position: fixed;
        top: 14px;
        right: 14px;
        background: rgba(18,20,27,.9);
        color: var(--fg);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 0;
        padding: 10px 12px;
        font-size: 14px;
        cursor: pointer;
      }
    </style>
  </head>
  <body data-page={Astro.url.pathname === '/' ? 'home' : 'inner'}>
    <header>
      <div class="wrap">
        <div class="nav-row">

          <nav class="nav-links" aria-label="Навигация">
            <a href=/cases>Кейсы</a>
            <a href=/cv>CV</a>
          </nav>

          <div class="nav-socials" aria-label="Социальные ссылки">
            <a class="nav-social" href="https://www.linkedin.com/in/dmitry-korchagin" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              <span class="sr-only">LinkedIn</span>
            </a>
            <a class="nav-social" href="mailto:nemokor@gmail.com" aria-label="Email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span class="sr-only">Email</span>
            </a>
            <a class="nav-social" href="https://t.me/ruugh" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.248-1.97 9.289c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.088 14.19l-2.95-.924c-.64-.203-.654-.64.136-.954l11.498-4.43c.535-.194 1.002.131.79.366z"/></svg>
              <span class="sr-only">Telegram</span>
            </a>
          </div>

        <button class="burger" type="button" aria-label="Меню" aria-expanded="false" id="burgerBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 7h14"></path>
            <path d="M5 12h14"></path>
            <path d="M5 17h14"></path>
          </svg>
        </button>
        </div>

        <div class="mobile-menu" id="mobileMenu" data-open="false">
          <a href=/cases>Кейсы</a>
          <a href=/cv>CV</a>
          <div class="mobile-socials">
            <a class="nav-social" href="https://www.linkedin.com/in/dmitry-korchagin" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              <span class="sr-only">LinkedIn</span>
            </a>
            <a class="nav-social" href="mailto:nemokor@gmail.com" aria-label="Email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span class="sr-only">Email</span>
            </a>
            <a class="nav-social" href="https://t.me/ruugh" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.248-1.97 9.289c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.088 14.19l-2.95-.924c-.64-.203-.654-.64.136-.954l11.498-4.43c.535-.194 1.002.131.79.366z"/></svg>
              <span class="sr-only">Telegram</span>
            </a>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="wrap">
        {backHref && (
          <a class="page-back" href={backHref}>
            <svg class="page-back__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6.53 3.47 2 8l4.53 4.53.94-.94L4.55 8.67H14v-1.34H4.55l2.92-2.92-.94-.94Z" fill="currentColor"></path>
            </svg>
            <span>{backLabel}</span>
          </a>
        )}
        <slot />
      </div>
    </main>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox__close" type="button" id="lightboxClose">Закрыть (Esc)</button>
      <img class="lightbox__img" id="lightboxImg" alt="" />
    </div>

    <script>
      (() => {
        const btn = document.getElementById('burgerBtn');
        const menu = document.getElementById('mobileMenu');
        if (!btn || !menu) return;

        const setOpen = (open) => {
          menu.dataset.open = open ? 'true' : 'false';
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        };

        btn.addEventListener('click', () => {
          const isOpen = menu.dataset.open === 'true';
          setOpen(!isOpen);
        });

        // Close on navigation
        menu.addEventListener('click', (e) => {
          const a = e.target?.closest?.('a[href]');
          if (a) setOpen(false);
        });
      })();
    </script>

    <script type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

      mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        securityLevel: 'loose',
      });

      const renderMermaid = async () => {
        const blocks = Array.from(document.querySelectorAll('.mermaid'));
        if (!blocks.length) return;
        try {
          await mermaid.run({ nodes: blocks });
        } catch (err) {
          console.error('Mermaid render failed', err);
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          renderMermaid();
        }, { once: true });
      } else {
        renderMermaid();
      }
    </script>

    <script>
      (() => {
        const lb = document.getElementById('lightbox');
        const img = document.getElementById('lightboxImg');
        const closeBtn = document.getElementById('lightboxClose');
        if (!lb || !img || !closeBtn) return;

        const open = (src, alt) => {
          img.src = src;
          img.alt = alt || '';
          lb.classList.add('open');
          lb.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        };

        const close = () => {
          lb.classList.remove('open');
          lb.setAttribute('aria-hidden', 'true');
          img.src = '';
          document.body.style.overflow = '';
        };

        // Event delegation: click any article image
        document.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof HTMLElement)) return;

          // Close when clicking backdrop or close button or the image itself
          if (target === lb || target === img || target === closeBtn) {
            close();
            return;
          }

          const mermaidSvg = target.closest('.mermaid svg');
          if (mermaidSvg instanceof SVGElement) {
            const serializer = new XMLSerializer();
            const svgText = serializer.serializeToString(mermaidSvg);
            const encoded = encodeURIComponent(svgText);
            const dataUrl = `data:image/svg+xml;charset=utf-8,${encoded}`;
            open(dataUrl, 'Mermaid diagram');
            return;
          }

          const el = target.closest('article img');
          if (!(el instanceof HTMLImageElement)) return;
          if (!el.src) return;

          // On the home page, images should behave like normal links to cases,
          // not open the lightbox.
          if (window.location.pathname === '/') return;

          // If the image is already wrapped in a link (for example to a case page),
          // let navigation happen instead of hijacking the click for lightbox.
          if (el.closest('a[href]')) return;

          open(el.src, el.alt);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
      })();
    </script>

