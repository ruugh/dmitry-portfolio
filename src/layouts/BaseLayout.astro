---
const { title = 'Дмитрий Корчагин', description = 'Портфолио' } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root { --bg:#0b0c10; --fg:#e6e6e6; --muted:#a8a8a8; --card:#12141b; --link:#7dd3fc; --border: rgba(255,255,255,.10); }
      body { margin:0; font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial; background: var(--bg); color: var(--fg); }
      :global(a),
      :global(a:visited) {
        color: var(--fg);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: rgba(255,255,255,.55);
      }
      :global(a:hover) { text-decoration-color: rgba(255,255,255,.9); }
      header { position: sticky; top:0; background: rgba(11,12,16,.85); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,.08); }
      .wrap { max-width: 760px; margin: 0 auto; padding: 16px 20px; }
      nav { display:flex; gap:14px; align-items:center; }
      nav a { color: var(--fg); opacity: .9; }
      main { padding: 28px 0 64px; }
      .grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); gap: 14px; }
      /* Home now renders purely from Notion content (see src/pages/index.astro) */
      .card { background: var(--card); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 14px 16px; display:block; transition: transform .12s ease, border-color .12s ease, background .12s ease; }
      .card:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.14); }
      :global(.card img) { width:100%; height: 220px; object-fit: contain; border-radius: 12px; margin-bottom: 10px; display:block; background: rgba(255,255,255,.03); }
      .card .title { display:block; font-weight: 700; }
      .muted { color: var(--muted); }

      /* HOME RESET: be strict about overflow and block defaults */
      article { overflow-x: hidden; }
      article :global(h1, h2, h3) { margin: 22px 0 10px; }
      article :global(p, li, blockquote) { line-height: 1.55; }

      /* Notion-ish defaults */
      article :global(figure) { margin: 18px 0; }
      article :global(img) { max-width: 100%; height: auto; display: block !important; }
      article :global(.notion-image figure) { margin: 0; }
      article :global(.notion-image img) { display: block !important; }

      /* Default images: centered, document-like */
      article :global(figure img) {
        max-width: min(100%, 820px);
        width: auto;
        height: auto;
        max-height: 72vh;
        object-fit: contain;
        border-radius: 12px;
        background: rgba(255,255,255,.03);
        border: 1px solid rgba(255,255,255,.08);
        margin: 0 auto;
        cursor: zoom-in;
      }

      /* Wide images: fill their container only (no bleed).
         IMPORTANT: target the stable marker (figure.wide) so it works even if wrapper divs change. */
      article :global(figure.wide) { margin: 18px 0; padding: 0; }
      article :global(figure.wide img) {
        width: 100% !important;
        max-width: 100% !important;
        height: auto;
        max-height: none;
        margin: 0;
        border: 0 !important;
        background: transparent !important;
        border-radius: 0;
        display: block !important;
      }

      article :global(figcaption) { margin-top: 8px; font-size: 14px; color: var(--muted); }
      article :global(blockquote) { border-left: 3px solid rgba(255,255,255,.15); margin: 16px 0; padding: 6px 12px; color: var(--muted); }
      article :global(hr) { border:0; border-top: 1px solid rgba(255,255,255,.1); margin: 22px 0; }
      :global(.callout) {
        background: rgba(255,255,255,.02);
        border: 1px solid rgba(255,255,255,.10);
        padding: 20px;
        border-radius: 14px;
      }
      :global(.callout-children) { margin-top: 12px; }
      /* Notion-like columns: no card frame/padding, just a gap */
      :global(.columns) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 32px;
        border: none;
        border-radius: 0;
        overflow: visible;
        background: transparent;
      }
      :global(.column) {
        min-width: 0;
        padding: 0;
        border: none;
        overflow: hidden;
      }
      :global(.column + .column) {
        border-left: none;
      }
      :global(details.toggle) { border: 1px solid rgba(255,255,255,.08); border-radius: 12px; padding: 10px 12px; background: rgba(255,255,255,.03); }
      :global(details.toggle > summary) { cursor: pointer; }

      :global(.table-wrap) { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 16px 0; }

      /* Debug/High-contrast table styling (we can soften later) */
      article :global(table) {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid rgba(255,255,255,.14);
      }
      article :global(th),
      article :global(td) {
        padding: 10px 12px;
        border: 1px solid rgba(255,255,255,.14);
        font-size: 14px;
      }
      article :global(th) {
        font-weight: 700;
        background: rgba(255,255,255,.04);
      }

      :global(table.notion-table) {
        border-collapse: collapse;
        width: 100%;
        min-width: 640px;
        background: rgba(255,255,255,.02);
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 12px;
        overflow: hidden;
      }
      :global(table.notion-table td),
      :global(table.notion-table th) {
        border-top: 1px solid rgba(255,255,255,.14);
        border-right: 1px solid rgba(255,255,255,.14);
        padding: 10px 12px;
        vertical-align: top;
        color: var(--fg);
        font-size: 14px;
      }
      :global(table.notion-table tr:first-child td),
      :global(table.notion-table tr:first-child th) { border-top: none; }
      :global(table.notion-table td:last-child),
      :global(table.notion-table th:last-child) { border-right: none; }
      :global(table.notion-table.has-header tr:first-child th) { background: rgba(255,255,255,.05); }
      footer { border-top: 1px solid rgba(255,255,255,.08); }

      /* Lightbox */
      .lightbox {
        position: fixed;
        inset: 0;
        display: none;
        place-items: center;
        background: rgba(0,0,0,.82);
        z-index: 9999;
        padding: 24px;
      }
      .lightbox.open { display: grid; }
      .lightbox__img {
        max-width: min(96vw, 1600px);
        max-height: 92vh;
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: 14px;
        box-shadow: 0 20px 80px rgba(0,0,0,.6);
        cursor: zoom-out;
      }
      .lightbox__close {
        position: fixed;
        top: 14px;
        right: 14px;
        background: rgba(18,20,27,.9);
        color: var(--fg);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 12px;
        padding: 10px 12px;
        font-size: 14px;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <nav>
          <a href="/">Главная</a>
          <a href="/cases">Кейсы</a>
          <a href="/cv">CV</a>
          <a href="/certificates">Сертификаты</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox__close" type="button" id="lightboxClose">Закрыть (Esc)</button>
      <img class="lightbox__img" id="lightboxImg" alt="" />
    </div>

    <script>
      (() => {
        const lb = document.getElementById('lightbox');
        const img = document.getElementById('lightboxImg');
        const closeBtn = document.getElementById('lightboxClose');
        if (!lb || !img || !closeBtn) return;

        const open = (src, alt) => {
          img.src = src;
          img.alt = alt || '';
          lb.classList.add('open');
          lb.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        };

        const close = () => {
          lb.classList.remove('open');
          lb.setAttribute('aria-hidden', 'true');
          img.src = '';
          document.body.style.overflow = '';
        };

        // Event delegation: click any article image
        document.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof HTMLElement)) return;

          // Close when clicking backdrop or close button or the image itself
          if (target === lb || target === img || target === closeBtn) {
            close();
            return;
          }

          const el = target.closest('article img');
          if (!(el instanceof HTMLImageElement)) return;
          if (!el.src) return;

          open(el.src, el.alt);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
      })();
    </script>

    <footer>
      <div class="wrap muted">© {new Date().getFullYear()} Dmitry Korchagin</div>
    </footer>
  </body>
</html>
