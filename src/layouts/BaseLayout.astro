---
const { title = 'Дмитрий Корчагин', description = 'Портфолио' } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root { --bg:#0b0c10; --fg:#e6e6e6; --muted:#a8a8a8; --card:#12141b; --link:#7dd3fc; }
      body { margin:0; font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial; background: var(--bg); color: var(--fg); }
      a { color: var(--link); text-decoration: none; }
      a:hover { text-decoration: underline; }
      header { position: sticky; top:0; background: rgba(11,12,16,.85); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,.08); }
      .wrap { max-width: 980px; margin: 0 auto; padding: 16px 20px; }
      nav { display:flex; gap:14px; align-items:center; }
      nav a { color: var(--fg); opacity: .9; }
      main { padding: 28px 0 64px; }
      .grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); gap: 14px; }
      .card { background: var(--card); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 14px 16px; display:block; }
      .card img { width:100%; height: 160px; object-fit: cover; border-radius: 10px; margin-bottom: 10px; display:block; }
      .card .title { display:block; font-weight: 700; }
      .muted { color: var(--muted); }
      article :global(h1, h2, h3) { margin: 22px 0 10px; }
      article :global(p, li, blockquote) { line-height: 1.55; }
      article :global(figure) { margin: 18px 0; }
      article :global(figure img) {
        max-width: 100%;
        width: auto;
        height: auto;
        max-height: 72vh;
        object-fit: contain;
        border-radius: 12px;
        background: rgba(255,255,255,.03);
        border: 1px solid rgba(255,255,255,.08);
        display: block;
        margin: 0 auto;
      }
      article :global(figcaption) { margin-top: 8px; font-size: 14px; color: var(--muted); }
      article :global(blockquote) { border-left: 3px solid rgba(255,255,255,.15); margin: 16px 0; padding: 6px 12px; color: var(--muted); }
      article :global(hr) { border:0; border-top: 1px solid rgba(255,255,255,.1); margin: 22px 0; }
      .callout { background: rgba(125,211,252,.08); border: 1px solid rgba(125,211,252,.18); padding: 10px 12px; border-radius: 12px; }
      footer { border-top: 1px solid rgba(255,255,255,.08); }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <nav>
          <a href="/">Главная</a>
          <a href="/cases">Кейсы</a>
          <a href="/cv">CV</a>
          <a href="/certificates">Сертификаты</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer>
      <div class="wrap muted">© {new Date().getFullYear()} Dmitry Korchagin</div>
    </footer>
  </body>
</html>
