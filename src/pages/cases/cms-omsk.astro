    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    border: 0;
  }
  .usability-carousel__viewport {
    overflow: hidden;
  }
  .usability-carousel__track {
    display: flex;
    transition: transform 0.35s ease;
    will-change: transform;
  }
  #usability-slide-1:checked ~ .usability-carousel__viewport .usability-carousel__track {
    transform: translateX(0);
  }
  #usability-slide-2:checked ~ .usability-carousel__viewport .usability-carousel__track {
    transform: translateX(-100%);
  }
  #usability-slide-3:checked ~ .usability-carousel__viewport .usability-carousel__track {
    transform: translateX(-200%);
