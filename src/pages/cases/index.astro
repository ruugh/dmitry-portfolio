---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCasesFromDatabase } from '../../lib/notion';

const cases = await getCasesFromDatabase();
---

<BaseLayout title="Кейсы — Дмитрий Корчагин">
  <h1>Кейсы</h1>
  <p class="muted">Список формируется из дочерних страниц Notion (кроме CV и Сертификатов).</p>

  <div class="cases-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,360px));gap:16px;justify-content:start;">
    {cases.map((c) => (
      <a class="card" style="max-width:360px;width:100%;" href={`/cases/${c.slug}/`}>
        {c.coverUrl ? <img src={c.coverUrl} alt={c.title} loading="lazy" /> : null}
        <span class="title">{c.title}</span>
        <div class="muted">Открыть →</div>
      </a>
    ))}
  </div>
</BaseLayout>
