---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCasesFromDatabase, renderNotionPageToHtml } from '../../lib/notion';

export async function getStaticPaths() {
  // Preview builds on Cloudflare Pages sometimes run without Notion env.
  // In that mode we skip generating case pages (UI experiments still build).
  if (process.env.ALLOW_MISSING_NOTION_ENV === '1' && !process.env.NOTION_TOKEN) {
    return [];
  }

  const cases = await getCasesFromDatabase();
  return cases.map((c) => ({ params: { slug: c.slug }, props: { pageId: c.id, title: c.title } }));
}

const { pageId, title } = Astro.props;
const html = await renderNotionPageToHtml(pageId);
---

<BaseLayout title={`${title} — кейс`}>
  <article>
    <h1>{title}</h1>
    <div set:html={html} />
  </article>
</BaseLayout>
