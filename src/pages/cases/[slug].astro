---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCasesFromDatabase, renderNotionPageToHtml } from '../../lib/notion';

export async function getStaticPaths() {
  // Preview/UI-only builds: do not generate case pages.
  if (process.env.OC_PREVIEW_HOME_ONLY === '1') return [];

  const cases = await getCasesFromDatabase();
  return cases.map((c) => ({ params: { slug: c.slug }, props: { pageId: c.id, title: c.title } }));
}

const { pageId, title } = Astro.props;
const html = await renderNotionPageToHtml(pageId);
---

<BaseLayout title={`${title} — кейс`}>
  <article>
    <h1>{title}</h1>
    <div set:html={html} />
  </article>
</BaseLayout>
