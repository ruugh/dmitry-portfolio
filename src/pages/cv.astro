---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNavItemsFromRoot, renderNotionPageToHtml } from '../lib/notion';

const items = await getNavItemsFromRoot();
const cv = items.find((x) => x.kind === 'cv');
const html = cv ? await renderNotionPageToHtml(cv.id) : '<p>CV страница не найдена в Notion.</p>';
---

<BaseLayout title="CV — Дмитрий Корчагин">
  <article>
    <h1>CV</h1>
    <div set:html={html} />
  </article>
</BaseLayout>
