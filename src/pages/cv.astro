---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CV_PAGE_ID_FALLBACK, getNavItemsFromRoot, renderNotionPageToHtml } from '../lib/notion';

const items = await getNavItemsFromRoot();
const cv = items.find((x) => x.kind === 'cv');
const cvPageId = cv?.id || CV_PAGE_ID_FALLBACK();
const html = await renderNotionPageToHtml(cvPageId);
---

<BaseLayout title="CV — Дмитрий Корчагин">
  <article class="cv-page">
    <h1>CV</h1>
    <div class="cv-content" set:html={html} />
  </article>
</BaseLayout>

<style>
  :global(.cv-page .cv-contact-block) {
    margin: 1rem 0 1.25rem;
  }

  :global(.cv-page .cv-contact-block p) {
    margin: 0.2rem 0;
  }

  :global(.cv-page .cv-content a[href="/cv"]) {
    display: none;
  }
</style>

<script>
  (() => {
    const root = document.querySelector('.cv-page .cv-content');
    if (!(root instanceof HTMLElement)) return;

    const nodes = Array.from(root.querySelectorAll('p, li, div'));
    let contactNode = null;

    for (const node of nodes) {
      const text = (node.textContent || '').trim();
      if (!text) continue;
      if (/email|mail|почта/i.test(text) && /telegram|телеграм|linkedin|portfolio|site|dmitrykorchagin\.org/i.test(text)) {
        contactNode = node;
        break;
      }
    }

    if (!contactNode) {
      contactNode = nodes.find((node) => /telegram|телеграм|linkedin|portfolio|site|dmitrykorchagin\.org/i.test((node.textContent || '').trim())) || null;
    }

    if (!contactNode) return;

    const text = (contactNode.textContent || '').trim();

    const emailMatch = text.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i);
    const phoneMatch = text.match(/\+?\d[\d\s()\-]{8,}\d/);
    const tgHandleMatch = text.match(/@([a-zA-Z0-9_]+)/);
    const linkedinUrlMatch = text.match(/https?:\/\/(?:www\.)?linkedin\.com\/[^\s]+/i);
    const siteUrlMatch = text.match(/https?:\/\/(?:www\.)?dmitrykorchagin\.org[^\s]*/i) || text.match(/(?:www\.)?dmitrykorchagin\.org[^\s]*/i);

    const email = emailMatch ? emailMatch[0] : null;
    const phone = phoneMatch ? phoneMatch[0].trim() : null;
    const telegramText = tgHandleMatch ? `@${tgHandleMatch[1]}` : 'Telegram';
    const telegramHref = tgHandleMatch ? `https://t.me/${tgHandleMatch[1]}` : 'https://t.me/Ruugh';
    const linkedinHref = 'https://www.linkedin.com/in/dmitry-korchagin-b217419b/';
    const linkedinText = linkedinUrlMatch ? linkedinUrlMatch[0] : 'LinkedIn';
    const siteHref = 'https://dmitry-portfolio.pages.dev/';
    const siteText = siteUrlMatch ? siteUrlMatch[0].replace(/^https?:\/\//i, '') : 'dmitrykorchagin.org';

    const wrapper = document.createElement('div');
    wrapper.className = 'cv-contact-block';

    const lines = [];
    if (email) lines.push(`<p><strong>Email:</strong> ${email}</p>`);
    if (phone) lines.push(`<p><strong>Телефон:</strong> ${phone}</p>`);
    lines.push(`<p><strong>Telegram:</strong> <a href="${telegramHref}">${telegramText}</a></p>`);
    lines.push(`<p><strong>LinkedIn:</strong> <a href="${linkedinHref}">${linkedinText}</a></p>`);
    lines.push(`<p><strong>Портфолио:</strong> <a href="${siteHref}">${siteText}</a></p>`);

    wrapper.innerHTML = lines.join('');
    contactNode.replaceWith(wrapper);

    const cleanupNodes = Array.from(root.querySelectorAll('p, li, div, a'));
    for (const node of cleanupNodes) {
      if (!node.isConnected || node === contactNode || wrapper.contains(node)) continue;
      const t = (node.textContent || '').trim();
      if (!t) continue;

      const isStandaloneCvLabel = t === 'CV';
      const isCvSelfLink = node instanceof HTMLAnchorElement && node.getAttribute('href') === '/cv';
      const isContactDuplicate = /telegram|телеграм|linkedin|portfolio|site|dmitrykorchagin\.org/i.test(t) && !/email|mail|почта|телефон|phone/i.test(t);

      if (isStandaloneCvLabel || isCvSelfLink || isContactDuplicate) {
        const container = node.closest('p, li, div') || node;
        if (container instanceof HTMLElement && container !== wrapper && !wrapper.contains(container)) {
          container.remove();
        } else {
          node.remove();
        }
      }
    }
  })();
</script>
