---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CV_PAGE_ID_FALLBACK, getNavItemsFromRoot, renderNotionPageToHtml } from '../lib/notion';

const items = await getNavItemsFromRoot();
const cv = items.find((x) => x.kind === 'cv');
const cvPageId = cv?.id || CV_PAGE_ID_FALLBACK();
const html = await renderNotionPageToHtml(cvPageId);
---

<BaseLayout title="CV — Дмитрий Корчагин">
  <article class="cv-page">
    <h1>CV</h1>
    <div class="cv-content" set:html={html} />
  </article>
</BaseLayout>

<style>
  :global(.cv-page .cv-content .cv-contacts-row) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin: 1rem 0;
  }

  :global(.cv-page .cv-content .cv-contacts-row a) {
    display: inline-block;
  }
</style>

<script>
  (() => {
    const root = document.querySelector('.cv-page .cv-content');
    if (!(root instanceof HTMLElement)) return;

    const blocks = Array.from(root.querySelectorAll('p, li, div'));
    const seen = new Set();

    const classify = (text, href = '') => {
      const t = (text || '').trim();
      const h = (href || '').trim();
      const lower = t.toLowerCase();
      const hrefLower = h.toLowerCase();

      if (hrefLower.includes('linkedin.com') || lower.includes('linkedin')) {
        return {
          kind: 'linkedin',
          href: hrefLower.includes('linkedin.com') ? h : 'https://www.linkedin.com/',
          text: t,
        };
      }

      if (hrefLower.includes('t.me') || hrefLower.includes('telegram.me') || lower.includes('telegram') || lower.includes('телеграм') || /@[a-zA-Z0-9_]+/.test(t)) {
        const m = t.match(/@([a-zA-Z0-9_]+)/);
        const href = hrefLower.includes('t.me') || hrefLower.includes('telegram.me')
          ? h
          : m ? `https://t.me/${m[1]}` : 'https://t.me/Ruugh';
        return { kind: 'telegram', href, text: t };
      }

      if (hrefLower.includes('dmitrykorchagin.org') || /dmitrykorchagin\.org|portfolio|website|site/i.test(t)) {
        let href = h;
        if (!href) {
          const m = t.match(/((?:https?:\/\/)?(?:www\.)?[a-z0-9.-]+\.[a-z]{2,}(?:\/[^\s]*)?)/i);
          if (m) href = /^https?:\/\//i.test(m[1]) ? m[1] : `https://${m[1]}`;
        }
        return { kind: 'site', href: href || 'https://dmitrykorchagin.org', text: t };
      }

      return null;
    };

    let contactHost = null;
    const collected = { site: null, telegram: null, linkedin: null };

    for (const block of blocks) {
      const links = Array.from(block.querySelectorAll('a[href]'));
      const blockText = (block.textContent || '').trim();
      const local = [];

      for (const a of links) {
        const item = classify(a.textContent || '', a.getAttribute('href') || '');
        if (item) local.push(item);
      }

      if (!local.length) {
        const item = classify(blockText, '');
        if (item) local.push(item);
      }

      if (!local.length) continue;
      if (!contactHost) contactHost = block;

      for (const item of local) {
        if (!collected[item.kind]) collected[item.kind] = item;
      }
    }

    if (!contactHost) return;

    const wrapper = document.createElement('div');
    wrapper.className = 'cv-contacts-row';

    for (const kind of ['site', 'telegram', 'linkedin']) {
      const item = collected[kind];
      if (!item || !item.href || seen.has(kind)) continue;
      seen.add(kind);
      const a = document.createElement('a');
      a.href = item.href;
      a.textContent = item.text;
      wrapper.appendChild(a);
    }

    contactHost.replaceWith(wrapper);

    for (const block of blocks) {
      if (!block.isConnected) continue;
      const text = (block.textContent || '').trim();
      if (/dmitrykorchagin\.org|linkedin|telegram|телеграм|@ruugh/i.test(text)) {
        block.remove();
      }
    }
  })();
</script>
