---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CV_PAGE_ID_FALLBACK, getNavItemsFromRoot, renderNotionPageToHtml } from '../lib/notion';

const items = await getNavItemsFromRoot();
const cv = items.find((x) => x.kind === 'cv');
const cvPageId = cv?.id || CV_PAGE_ID_FALLBACK();
const html = await renderNotionPageToHtml(cvPageId);
---

<BaseLayout title="CV — Дмитрий Корчагин">
  <article class="cv-page">
    <h1>CV</h1>
    <div class="cv-content" set:html={html} />
  </article>
</BaseLayout>

<style>
  :global(.cv-page .cv-contact-links) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin: 1rem 0;
  }

  :global(.cv-page .cv-contact-links a) {
    display: inline-block;
  }
</style>

<script>
  (() => {
    const root = document.querySelector('.cv-page .cv-content');
    if (!(root instanceof HTMLElement)) return;

    const paragraphs = Array.from(root.querySelectorAll('p'));
    for (const p of paragraphs) {
      const links = Array.from(p.querySelectorAll('a[href]'));
      if (links.length < 2) continue;

      const contactLinks = links.filter((a) => {
        const href = (a.getAttribute('href') || '').toLowerCase();
        return href.includes('t.me') || href.includes('telegram.me') || href.includes('linkedin.com');
      });

      const hasTelegram = contactLinks.some((a) => {
        const href = (a.getAttribute('href') || '').toLowerCase();
        return href.includes('t.me') || href.includes('telegram.me');
      });
      const hasLinkedIn = contactLinks.some((a) => (a.getAttribute('href') || '').toLowerCase().includes('linkedin.com'));

      if (!hasTelegram || !hasLinkedIn) continue;

      const wrapper = document.createElement('div');
      wrapper.className = 'cv-contact-links';

      for (const link of contactLinks) {
        wrapper.appendChild(link.cloneNode(true));
      }

      p.replaceWith(wrapper);
      break;
    }
  })();
</script>
