---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCasesFromDatabase } from '../lib/notion';

const cases = await getCasesFromDatabase();
---

<BaseLayout title="Лендинг — Дмитрий Корчагин" description="Продуктовый UX/UI-дизайнер. B2B SaaS. Сложные интерфейсы.">
  <section class="card" style="padding:26px 24px; border-color: rgba(125,211,252,.18); background: linear-gradient(180deg, rgba(125,211,252,.08), rgba(255,255,255,.02));">
    <p class="muted" style="margin:0 0 10px;">Продуктовый UX/UI-дизайнер</p>
    <h1 style="margin:0 0 10px; font-size:44px; line-height:1.05; letter-spacing:-0.02em;">Дмитрий Корчагин</h1>
    <p class="muted" style="margin:0 0 18px; font-size:16px; max-width: 62ch;">
      B2B SaaS и сложные интерфейсы: админки, роли/права, таблицы, сценарии, UX для операций.
    </p>

    <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
      <a class="card" style="padding:10px 14px; border-color: rgba(125,211,252,.25);" href="/cases">Смотреть кейсы</a>
      <a class="card" style="padding:10px 14px;" href="/cv">CV</a>
      <a class="card" style="padding:10px 14px;" href="https://t.me/ruugh" target="_blank" rel="noreferrer">Написать в Telegram</a>
      <span class="muted" style="margin-left:auto;">Omsk · UTC+6</span>
    </div>
  </section>

  <section style="margin-top:22px;">
    <div class="grid">
      <div class="card">
        <strong style="display:block; margin-bottom:6px;">Что делаю</strong>
        <div class="muted">Исследования, сценарии, прототипы, дизайн-системы, handoff.</div>
      </div>
      <div class="card">
        <strong style="display:block; margin-bottom:6px;">С чем работаю</strong>
        <div class="muted">CRM/CMS/админ‑панели, таблицы, роли и права, метрики.</div>
      </div>
      <div class="card">
        <strong style="display:block; margin-bottom:6px;">Цель</strong>
        <div class="muted">Ускорять работу пользователей: меньше кликов, проще флоу, меньше ошибок.</div>
      </div>
    </div>
  </section>

  <section style="margin-top:22px;">
    <div style="display:flex; align-items:end; justify-content:space-between; gap:12px;">
      <div>
        <h2 style="margin:0 0 6px;">Кейсы</h2>
        <p class="muted" style="margin:0;">Последние опубликованные (из базы Notion).</p>
      </div>
      <a href="/cases">Все →</a>
    </div>

    <div class="grid" style="margin-top:12px;">
      {cases.slice(0, 6).map((c) => (
        <a class="card" href={`/cases/${c.slug}/`}>
          {c.coverUrl ? <img src={c.coverUrl} alt={c.title} loading="lazy" /> : null}
          <span class="title">{c.title}</span>
          {c.summary ? <div class="muted" style="margin-top:6px;">{c.summary}</div> : <div class="muted" style="margin-top:6px;">Открыть →</div>}
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top:22px;" class="card">
    <h2 style="margin:0 0 10px;">Контакты</h2>
    <ul style="margin:0;">
      <li>Email: <a href="mailto:nemokor@gmail.com">nemokor@gmail.com</a></li>
      <li>Telegram: <a href="https://t.me/ruugh" target="_blank" rel="noreferrer">@ruugh</a></li>
    </ul>
  </section>
</BaseLayout>
