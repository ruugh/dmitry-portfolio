---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNavItemsFromRoot, renderNotionPageToHtml, ROOT_PAGE_ID } from '../lib/notion';

const items = await getNavItemsFromRoot();
const cases = items.filter((x) => x.kind === 'case');
const homeHtml = await renderNotionPageToHtml(ROOT_PAGE_ID());
---

<BaseLayout title="Дмитрий Корчагин — портфолио" description="Портфолио Дмитрия Корчагина">
  <article>
    <div set:html={homeHtml} />
  </article>

  <h2>Портфолио</h2>
  <div class="grid">
    {cases.map((c) => (
      <a class="card" href={`/cases/${c.slug}/`}>
        {c.coverUrl ? <img src={c.coverUrl} alt={c.title} loading="lazy" /> : null}
        <span class="title">{c.title}</span>
        <div class="muted">Открыть →</div>
      </a>
    ))}
  </div>
</BaseLayout>
