---
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderNotionPageToHtml, ROOT_PAGE_ID } from '../lib/notion';

// Home page is rendered purely from Notion for 1:1 layout control.
// Do not auto-wide images on home; use explicit tags (#wide / #wNNN).
const homeHtml = await renderNotionPageToHtml(ROOT_PAGE_ID(), { wideImagesWithCaption: false });
---

<BaseLayout title="Дмитрий Корчагин — портфолио" description="Портфолио Дмитрия Корчагина">
  <article>
    <div id="homeContent" set:html={homeHtml} />
  </article>

  <script>
    (() => {
      const root = document.getElementById('homeContent');
      if (!root) return;

      const normalizeTelegramHref = (href, text) => {
        const raw = (href || '').trim();
        const label = (text || '').trim().toLowerCase();
        const fromResolve = raw.match(/tg:\/\/resolve\?domain=([^&]+)/i);
        if (fromResolve) return `https://t.me/${fromResolve[1].replace(/^@/, '')}`;
        const fromTmeAt = raw.match(/^https?:\/\/t\.me\/@([^/?#]+)/i);
        if (fromTmeAt) return `https://t.me/${fromTmeAt[1]}`;
        if (/^@[^\s/]+$/.test(raw)) return `https://t.me/${raw.replace(/^@/, '')}`;
        if ((label === 'telegram' || label === 'телеграм' || label === 'tg') && (!raw || raw === '#' || raw === '/')) {
          return 'https://t.me/Ruugh';
        }
        return raw;
      };

      const links = Array.from(root.querySelectorAll('a'));
      const images = Array.from(root.querySelectorAll('img'));

      // Normalize obvious special links first.
      for (const link of links) {
        const text = (link.textContent || '').trim();
        const lower = text.toLowerCase();
        const href = link.getAttribute('href') || '';

        if (lower === 'cv') {
          link.setAttribute('href', '/cv');
        }

        const tgHref = normalizeTelegramHref(href, text);
        if (tgHref && tgHref !== href) {
          link.setAttribute('href', tgHref);
        }
      }

      // If Notion rendered plain text instead of links for Telegram/CV, force-wrap them.
      const exactTextNodes = Array.from(root.querySelectorAll('p, li, div, span')).filter((el) => {
        const txt = (el.textContent || '').trim().toLowerCase();
        return (txt === 'telegram' || txt === 'телеграм' || txt === 'cv') && !el.querySelector('a[href]');
      });

      for (const el of exactTextNodes) {
        const txt = (el.textContent || '').trim();
        const lower = txt.toLowerCase();
        const href = lower === 'cv' ? '/cv' : 'https://t.me/Ruugh';
        el.innerHTML = `<a href="${href}">${txt}</a>`;
      }

      // Then convert "Подробнее о проекте" to strong CTA and attach the same href to the nearest image above.
      for (const link of links) {
        const text = (link.textContent || '').trim().toLowerCase();
        if (text !== 'подробнее о проекте') continue;

        link.innerHTML = `<strong>${link.innerHTML}</strong>`;

        const href = link.getAttribute('href');
        if (!href) continue;

        const p = link.closest('p');
        if (p) p.classList.add('case-cta');

        let targetImg = null;
        for (const img of images) {
          const pos = img.compareDocumentPosition(link);
          const isBefore = !!(pos & Node.DOCUMENT_POSITION_FOLLOWING);
          if (isBefore) targetImg = img;
        }

        if (!targetImg) continue;
        if (targetImg.closest('a[href]')) continue;

        const wrapper = targetImg.closest('figure, .notion-image, p, div') || targetImg;
        if (wrapper.closest('a[href]')) continue;

        const a = document.createElement('a');
        a.href = href;
        a.className = 'case-image-link';
        wrapper.parentNode?.insertBefore(a, wrapper);
        a.appendChild(wrapper);
      }
    })();
  </script>
</BaseLayout>
